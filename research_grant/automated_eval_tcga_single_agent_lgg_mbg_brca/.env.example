# --- Models (ADR-0002: agents are OpenAI-only) ---
OPENAI_API_KEY=sk-...
AGENT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large

# --- Judge (ADR-0003: held out from the agent's model family) ---
# Agents run on OpenAI, so the judge is Anthropic by default. A same-family judge
# carries a known self-preference bias on the headline metric.
ANTHROPIC_API_KEY=sk-ant-...
JUDGE_MODEL=claude-opus-4-5

# --- Data sources ---
CBIOPORTAL_BASE_URL=https://www.cbioportal.org/api
CBIOPORTAL_STUDY_ID=brca_tcga_pan_can_atlas_2018
# Optional: raises the PubMed rate limit from 3/s to 10/s
NCBI_API_KEY=

# --- Stores ---
# Chainlit data layer / benchmark run store (ADR-0005)
RUNS_DB_URL=sqlite+aiosqlite:///data/runs.db
# sqlite-vec retrieval index (ADR-0004)
CORPUS_DB_PATH=data/corpus.db

# --- Agent bounds (ADR-0002; frozen values live in docs/experiment_metadata.md) ---
MAX_STEPS=25
TOOL_TIMEOUT_SECONDS=60
ANALYSIS_TIMEOUT_SECONDS=120
SEED=0
